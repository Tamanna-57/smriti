# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/SIH

# Authentication
JWT_SECRET=your_jwt_secret_here
PORT=5000
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key

# Test Patient WhatsApp Number (E.164 format without +)
MY_WHATSAPP_NUMBER=919435012345

# Server time zone: reminder times in seed.js use it (Render defaults to UTC)
TZ=Asia/Kolkata

# Hosted demo only: 'if-empty' seeds an empty database, 'daily' also refreshes
# the demo reminders each day. seed.js wipes every collection first.
# DEMO_SEED=daily

# Optional: external ML engine (adaptive difficulty, health score, translation)
# ML_SERVICE_URL=https://dementia-ai-engine.onrender.com
